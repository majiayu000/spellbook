{
  "schema_version": 1,
  "source_policy": {
    "local_only_canonical_registry": "~/.loom-registry",
    "projection_roots": [
      "~/.agents/skills",
      "~/.claude/skills"
    ],
    "projection_globs": [
      "~/src/project-*/.agents/skills"
    ],
    "inventory_roots": [
      {
        "path": "~/src/spellbook/skills",
        "kind": "canonical_source",
        "owner": "spellbook"
      },
      {
        "path": "~/src/repository-style-skill",
        "kind": "repository_source",
        "owner": "independent-git"
      },
      {
        "path": "~/.gemini/skills",
        "kind": "managed_projection",
        "owner": "skill-installer"
      }
    ]
  },
  "pinned_materializations": [],
  "retired_skills": [],
  "quarantined_skills": [],
  "projection_denials": [],
  "retired_reference_allowlist": [],
  "external_actions": [],
  "skill_decisions": [
    {
      "name": "example-skill",
      "decision": "keep",
      "reason": "Distinct capability with a maintained canonical source.",
      "owner": "spellbook",
      "canonical_path": "~/src/spellbook/skills/example-skill",
      "evidence": [
        "source review",
        "fresh validator run"
      ]
    }
  ]
}
